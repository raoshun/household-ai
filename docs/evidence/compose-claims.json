{
  "gate": "compose-claims",
  "config_source": "docker compose config --format json",
  "claims": [
    {
      "claim": "phase0_compose_service_set",
      "measured": "services=[\"api\", \"gate\", \"proof\", \"runtime\", \"ui-bridge\"] default_up=[\"runtime\"] profiles={\"api\": [\"ui\"], \"gate\": [\"checks\"], \"proof\": [\"checks\"], \"runtime\": [], \"ui-bridge\": [\"checks\"]}"
    },
    {
      "claim": "single_pinned_image",
      "measured": "{\"api\": \"household-ai-runtime-test:0.1.0\", \"gate\": \"household-ai-runtime-test:0.1.0\", \"proof\": \"household-ai-runtime-test:0.1.0\", \"runtime\": \"household-ai-runtime-test:0.1.0\", \"ui-bridge\": \"household-ai-runtime-test:0.1.0\"}"
    },
    {
      "claim": "credentials_not_baked",
      "measured": "compose literals=[] expanded={\"api\": {\"AI_API_KEY\": {\"present\": true, \"value_class\": \"placeholder\"}, \"COPILOT_GITHUB_TOKEN\": {\"present\": true, \"value_class\": \"placeholder\"}, \"GH_TOKEN\": {\"present\": false, \"value_class\": \"placeholder\"}, \"GITHUB_TOKEN\": {\"present\": false, \"value_class\": \"placeholder\"}}, \"gate\": {\"AI_API_KEY\": {\"present\": false, \"value_class\": \"placeholder\"}, \"COPILOT_GITHUB_TOKEN\": {\"present\": false, \"value_class\": \"placeholder\"}, \"GH_TOKEN\": {\"present\": false, \"value_class\": \"placeholder\"}, \"GITHUB_TOKEN\": {\"present\": false, \"value_class\": \"placeholder\"}}, \"proof\": {\"AI_API_KEY\": {\"present\": true, \"value_class\": \"placeholder\"}, \"COPILOT_GITHUB_TOKEN\": {\"present\": true, \"value_class\": \"placeholder\"}, \"GH_TOKEN\": {\"present\": false, \"value_class\": \"placeholder\"}, \"GITHUB_TOKEN\": {\"present\": false, \"value_class\": \"placeholder\"}}, \"runtime\": {\"AI_API_KEY\": {\"present\": true, \"value_class\": \"placeholder\"}, \"COPILOT_GITHUB_TOKEN\": {\"present\": true, \"value_class\": \"placeholder\"}, \"GH_TOKEN\": {\"present\": false, \"value_class\": \"placeholder\"}, \"GITHUB_TOKEN\": {\"present\": false, \"value_class\": \"placeholder\"}}, \"ui-bridge\": {\"AI_API_KEY\": {\"present\": true, \"value_class\": \"placeholder\"}, \"COPILOT_GITHUB_TOKEN\": {\"present\": true, \"value_class\": \"placeholder\"}, \"GH_TOKEN\": {\"present\": false, \"value_class\": \"placeholder\"}, \"GITHUB_TOKEN\": {\"present\": false, \"value_class\": \"placeholder\"}}}"
    },
    {
      "claim": "data_volume_mount",
      "measured": "named_volumes=[\"household-data\"] runtime=[\"household-data:/app/data:rw\"] api=[\"household-data:/app/data:rw\"]"
    },
    {
      "claim": "host_ollama_gateway",
      "measured": "{\"api\": [\"host.docker.internal=host-gateway\"], \"gate\": [], \"proof\": [\"host.docker.internal=host-gateway\"], \"runtime\": [\"host.docker.internal=host-gateway\"], \"ui-bridge\": [\"host.docker.internal=host-gateway\"]}"
    },
    {
      "claim": "gate_uses_working_tree_ro",
      "measured": "[\"<repo>/backend/app:/app/backend/app:ro\", \"<repo>/tests:/app/tests:ro\"]"
    },
    {
      "claim": "proof_state_in_container_tmp",
      "measured": "state={\"COPILOT_RUNTIME_DIR\": \"/tmp/proof-runtime\", \"DATA_DIR\": \"/tmp/proof-data\"} proof_volumes=[]"
    },
    {
      "claim": "secrets_and_data_excluded_from_image",
      "measured": "excluded=[\"*.py[oc]\", \"*.zcode.*\", \".env\", \".env.*\", \".git\", \".github\", \".pytest_cache/\", \".ruff_cache/\", \".spike/\", \".venv*/\", \".venv/\", \"__pycache__/\", \"copilot-runtime/\", \"data/\", \"frontmatter.json\", \"installed-plugins/\", \"logs/\", \"session-state/\"] copy_sources=[\"./\", \"./README.md\", \"./app\", \"/app/docs/pinned-runtime-versions.json\", \"/app/skills\", \"/app/tests\", \"backend/README.md\", \"backend/app\", \"backend/pyproject.toml\", \"backend/uv.lock\", \"docs/pinned-runtime-versions.json\", \"skills\", \"tests\"]"
    },
    {
      "claim": "ui_bridge_state_and_mounts",
      "measured": "state={\"COPILOT_RUNTIME_DIR\": \"/tmp/ui-proof-runtime\", \"DATA_DIR\": \"/tmp/ui-proof-data\"} mounts={\"/app/backend/app\": {\"source\": \"<repo>/backend/app\", \"mode\": \"ro\", \"named\": false}, \"/app/tests\": {\"source\": \"<repo>/tests\", \"mode\": \"ro\", \"named\": false}, \"/out\": {\"source\": \"<repo>/.local/ui/out\", \"mode\": \"rw\", \"named\": false}} command=timeout 1200 sh -c .venv/bin/python -m pytest tests/live -q -p no:cacheprovider --tb=short --import-mode=importlib -rf"
    },
    {
      "claim": "ui_published_ports_loopback_only",
      "measured": "api ports=[\"127.0.0.1:8000->8000/tcp mode=ingress\"] all_ports={\"api\": [\"127.0.0.1:8000->8000/tcp mode=ingress\"], \"gate\": [], \"proof\": [], \"runtime\": [], \"ui-bridge\": []}"
    }
  ],
